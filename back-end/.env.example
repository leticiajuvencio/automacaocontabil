# Copie para .env e ajuste.
PORT=3333
DATABASE_URL="postgresql://frasson:frasson@localhost:5434/contabilidade_frasson?schema=public"
# Segredo do token de login. Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-bem-longo
# Endereço do front (Vite)
CORS_ORIGIN=http://localhost:5173
# Pasta onde os PDFs dos extratos ficam salvos
UPLOAD_DIR=uploads
# Tamanho máximo de cada arquivo enviado (PDF ou XML) em MB
UPLOAD_MAX_MB=15
# API do Domínio: client ID e secret vêm do cadastro "Integração online com qualquer ERP" da Domínio Sistemas
DOMINIO_CLIENT_ID=
DOMINIO_CLIENT_SECRET=
# homologacao (chave de teste pedida à Domínio) ou producao
DOMINIO_AMBIENTE=homologacao
